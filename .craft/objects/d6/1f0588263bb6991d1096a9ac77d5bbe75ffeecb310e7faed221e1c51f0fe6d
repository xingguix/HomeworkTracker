extends Button

@onready var https = $"../../../https"
@onready var content = $"../content"
@onready var subject = $"../subject"
@onready var alert = $"../alert"


func _on_pressed():
	alert.text = ""
	if not subject.text:
		alert.text += "你没填入学科！"
	if not content.text:
		alert.text += "你没填入具体作业！"
	
	var added: bool = false
	
	var data = await https.get_homework() #[{ "subject": "数学", "contents": ["数学卷", "整理笔记"] }, { "subject": "语文", "contents": ["语文卷", "背诗"] }]
	if not data:
		data = []
	for i in data:
		if i["subject"] == subject.text:
			i["contents"].append(content.text)
			added = true
			break
	if not added: # 这就说明学科不存在
		data.append({ "subject": subject.text, "contents": [content.text] })
	
	
	await https.post_homework(JSON.stringify(data))
	$"../../Timer".start()
	await $"../../Timer".timeout
	$"../../ScrollContainer/整体".refresh()
