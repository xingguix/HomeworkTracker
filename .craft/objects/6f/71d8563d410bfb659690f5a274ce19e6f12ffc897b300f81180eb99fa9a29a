extends HTTPRequest

signal get_return

## data格式: [key, name]
func add_key(data):
	print(data)
	var key = $"..".key
	var custom_headers = $"..".get_custom_headers() + ["Content-Type: application/json"]
	# 开始发送请求
	var error = request($"..".url + "/add_key", custom_headers, HTTPClient.METHOD_POST, JSON.stringify(data))
	if error != OK:
		print("请求发送失败")


func _on_request_completed(result, response_code, headers, body: PackedByteArray):
	var server_return: String = body.get_string_from_utf8()
	emit_signal("get_return", server_return)
