func start_cooldown():
	cooldown = true
	cooldown_timer.start()

func _on_cooldown_timer_timeout():
	cooldown = false

func delete_tasks(tasks: Array):
	var homework = await https.get_homework() # [{ "contents": ["测试"], "subject": "数学" }]
	for task in tasks:
		for i in homework:
			if i.subject == task.subject: # 找到自己学科所在位置
				for j in i.contents:
					if j == task.get_final_text():
						i.contents.erase(j)
	print(homework)
	await https.post_homework(JSON.stringify(homework))

func delete_due_task():
	var delete_array: Array
	for subject in get_children():
		for task in subject.get_children():
			if task is Task:
				if task.due():
					delete_array.append(task)
	await delete_tasks(delete_array)
	refresh()
