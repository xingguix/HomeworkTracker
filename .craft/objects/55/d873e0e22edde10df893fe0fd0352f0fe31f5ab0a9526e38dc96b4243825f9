extends Node


var defualt_url:String = "http://59.47.74.10:27256"
var url:String = defualt_url
# var url = "http://127.0.0.1:5000"
var version: float = 4.9
var key: int
signal already

func post_homework(data):
	$post.send_post_request(data)

func get_homework():
	return await $get.get_homework()

func delete_homework():
	$delete.delete_homework()

func check_op(key: int):
	return await $check_op.check_op(key)

func get_ops() -> Array:
	return await $get_ops.get_ops()

func add_key(data):
	$add_key.add_key(data)



func read_key():
	var key_file = FileAccess.open("user://key.data", FileAccess.READ)
	if not key_file:
		return
	var user_key = key_file.get_as_text().to_int()
	key = user_key

func read_server_IP():
	var server_IP_file = FileAccess.open("user://server_IP.data", FileAccess.READ)
	if not server_IP_file:
		return
	var user_server_IP = server_IP_file.get_as_text()
	url = user_server_IP


func get_custom_headers():
	return ["X-App-Version: " + str(version), "X-App-Key: " + str(key)]

func _ready():
	TransferStation.https = self
	emit_signal("already")

func _physics_process(delta):
	read_key()
	read_server_IP()
