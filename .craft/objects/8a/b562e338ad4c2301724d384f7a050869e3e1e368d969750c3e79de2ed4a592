extends HTTPRequest

var ops:Array

func get_ops():
	var custom_headers = $"..".get_custom_headers()
	request($"..".url + "/getOPs", custom_headers)
	await request_completed
	return ops

func _on_request_completed(result, response_code, headers, body):
	ops = JSON.parse_string(body.get_string_from_utf8())
	
func _ready():
	print(await get_ops())
