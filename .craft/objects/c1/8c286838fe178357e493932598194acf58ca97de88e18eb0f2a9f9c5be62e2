extends Control

@onready var sub_viewport = $ScreenshotViewport
@onready var main = %整体
@onready var screen_texture = $Panel/ScreenTexture
@onready var panel = $Panel
@onready var timer = $Timer

func _on_screenshot_button_pressed():
	var scroll_contianer:ScrollContainer = main.get_parent()
	var v_scroll_bar: VScrollBar = scroll_contianer.get_v_scroll_bar()
	v_scroll_bar.value = 0
	
	var positions: Array = []
	for i in main.get_children():
		if i is SubjectField:
			for j in i.get_children():
				sub_viewport.add_child(j.duplicate())
				if j is Task:
					positions.append(j.global_position.y + j.size.y)
	
	positions.sort()
	var max_position = positions.back()
	print(max_position)
	var defualt_size = get_tree().root.content_scale_size
	var defualt_scrooll_size = scroll_contianer.size
	get_tree().root.content_scale_size.y = max_position
	scroll_contianer.size.y = max_position
	timer.start()
	await timer.timeout
	# 开始截图
	var texture = ImageTexture.create_from_image(get_viewport().get_texture().get_image())
	#截图完事
	get_tree().root.content_scale_size = defualt_size
	scroll_contianer.size = defualt_scrooll_size
	
	panel.show()
	print(OS.get_system_dir(OS.SYSTEM_DIR_PICTURES))
	texture.get_image().save_png(OS.get_system_dir(OS.SYSTEM_DIR_PICTURES) + "/homework_pic.png")
