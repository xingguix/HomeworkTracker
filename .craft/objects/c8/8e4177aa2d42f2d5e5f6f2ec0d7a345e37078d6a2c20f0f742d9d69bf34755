@tool
extends Panel
class_name SwitchButtn

@onready var button = $"按钮"
@onready var icon = $Icon
@onready var show = icon.get_node("show")
@onready var hide = icon.get_node("hide")
@export var panel: Control
@export var text: String = "文本"

signal on
signal off

func _process(delta):
	button.text = text

func _on_显示按钮_toggled(toggled_on):
	button.button_pressed = toggled_on
	if panel:
		panel.visible = toggled_on
	show.visible = toggled_on
	hide.visible = !toggled_on
	if toggled_on:
		emit_signal("on")
	else:
		emit_signal("off")
