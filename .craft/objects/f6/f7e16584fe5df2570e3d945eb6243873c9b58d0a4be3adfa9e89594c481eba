extends TextureButton

@onready var http = TransferStation.https
@export var main: Main
@export var textedit: TextEdit
@export var panel: Control
@export var copy_button: TextureButton

func generate_text() -> String:
	var text: String
	var project_name = ProjectSettings.get_setting("application/config/name")
	var time = Time.get_datetime_dict_from_system()
	text += "------" + str(time["month"]) + "月" + str(time["day"]) + "日作业" + "------\n"
	for i in main.get_children():
		if i is SubjectField and not i.is_empty():
			text += i.subject_name + ':\n'
			for j in i.get_children():
				if j is Task:
					text += "	"+j.text
					if j.state == true:
						text += "✅"
					text += "\n"
	text += "--------来自" + project_name + "--------"
	return text

func _on_pressed():
	textedit.text = generate_text()
	panel.show()
	copy_button._on_pressed()
