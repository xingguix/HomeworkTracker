extends TextureButton

@onready var control = $Control
var https = TransferStation.https
@onready var task = $".."

func _on_pressed():
	control.visible = true


func _on_cancel_pressed():
	control.visible = false

func _on_accept_pressed():
	var homework = await https.get_homework() # [{ "contents": ["测试"], "subject": "数学" }]
	for i in homework:
		if i.subject == task.get_subject():
			for j in i.contents:
				if j == task.get_text():
					i.contents.erase(j)
	
	await https.post_homework(JSON.stringify(homework))
	task.get_node("..").queue_free()
