extends HTTPRequest


func _ready():
	send_post_request("http://42.202.37.195:27256/post", JSON.stringify([{"subject" : "math", "contnt" : ["oknice"]}]))



func send_post_request(url, data):
	# 设置请求头部，告诉服务器我们正在发送JSON数据
	var headers = ["Content-Type: application/json"]
	# 开始发送请求
	var error = request(url, headers, HTTPClient.METHOD_POST, data)
	if error != OK:
		print("请求发送失败")

func _on_request_completed(result, response_code, headers, body):
	pass
