extends Panel
class_name Task

@onready var buttonclicksound: AudioStreamPlayer2D = $buttonclicksound
@onready var yeesound: AudioStreamPlayer2D = $yeesound
@onready var texture_rect: TextureRect = $"完成按钮/TextureRect"
@onready var label: TextEdit = $Label
@onready var button: Button = $"完成按钮"
@onready var big_button = $"大型完成按钮"
@onready var date_label: Label = $Date/DateLabel
@onready var date_input = $Date/DateInput
@onready var trash = $trash

@export var text: String = ""
@export var editable: bool ## 决定此task是否可编辑
@export var enable_big_button: bool = true
var state: bool = false
var deleting: bool = false
var subject: String
var date: int

signal task_state_changed(task: Task, state: bool)

func _ready():
	label.text = text

func _process(delta):
	if not editable:
		label.text = text
	else:
		text = label.text
	texture_rect.visible = state
	
	switch_scale()
	refresh_date()
	editing()


## 解析该任务 像这样: "能培unit9全部写完%1716768000"
func parse() -> String:
	var final_text = text
	if date:
		final_text += "%" + str(date)
	return final_text

func parse_with_subject() -> String:
	return subject + "/" + parse()

func toggle():
	state = !state
	#if particle:
		#particle.emit_signal("emit")
	emit_signal("task_state_changed", self, state)
	if state:
		yeesound.pitch_scale = randf_range(0.9, 1.1)
		yeesound.start()

func _on_完成按钮_pressed():
	toggle()
	buttonclicksound.play()
	button.hide()
	button.show()
	# 用来释放焦点

func switch_scale():
	#var line_count = label.get_line_count()
	#var total_height = label.get_line_height() * line_count * 1.2 + date_label.size.y
	#if total_height <= custom_minimum_size.y:
		#return
	var total_height: float = label.get_minimum_size().y + date_label.get_minimum_size().y * 1.5
	custom_minimum_size.y = total_height

func calculate_date_day_difference(date1: int, date2: int) -> int:
	var difference = ceil(float(date1 - date2) / (1 * 60 * 60 * 24))
	return int(difference)

func day_difference() -> int:
	return calculate_date_day_difference(date, Time.get_unix_time_from_system())

func difference_to_date(date1: Dictionary, days: float) -> int:
	var result_day = Time.get_unix_time_from_datetime_dict(date1) + (1 * 60 * 60 * 24) * days
	return result_day
func refresh_date():
	if not date:
		date_label.hide()
		date_label.text = ""
		date_label.custom_minimum_size = Vector2(0,0)
		return
	
	var time: int = day_difference()
	if time > 0:
		date_label.text = "还剩" + str(time) + "天"
		date_label.modulate = Color.FLORAL_WHITE
	elif time == 0:
		date_label.text = "今天"
		date_label.modulate = Color.RED
	else:
		date_label.text = str(-time) + "天前"
		date_label.modulate = Color.RED
	pass

## 返回当前任务是否到期
func due() -> bool:
	if date == 0:
		return false
	return day_difference() <= 0

func change_big_button_state(big_button_state: bool):
	big_button.visible = big_button_state

func editing():
	label.editable = editable
	if enable_big_button:
		change_big_button_state(!editable)
	date_input.visible = editable
	date_label.visible = !editable
	trash.visible = editable and text # 必须既在编辑还有text才行
	if not date_input.has_focus():
		if date:
			date_input.text = str(day_difference())
		else :
			date_input.text = ""
	if not editable:
		if deleting or not text:
			queue_free()

func _on_date_input_text_submitted(new_text):
	hide()
	show()

func _on_date_input_focus_exited():
	if not date_input.text:
		date = 0
		return
	date = difference_to_date(Time.get_date_dict_from_system(), int(date_input.text))
