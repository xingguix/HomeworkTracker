extends AudioStreamPlayer2D

@onready var timer = $Timer

var audio = preload("res://sound/yee.wav")


func start(time :float = 3):
	timer.wait_time = time
	timer.start()
	play()
	await timer.timeout
	var tween = create_tween()
	var over_time:float = 1
	
	tween.tween_property(self, "volume_db", -50, over_time)
	timer.wait_time = over_time
	await timer.timeout
	
	stop()
	self.volume_db = 0
	tween.free()
