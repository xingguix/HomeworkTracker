extends HTTPRequest

func send_post_request(data):
	var custom_headers = $"..".get_custom_headers() + ["Content-Type: application/json"]
	# 开始发送请求
	var error = request($"..".url + "/post", custom_headers, HTTPClient.METHOD_POST, data)
	if error != OK:
		print("请求发送失败")

func _on_request_completed(result, response_code, headers, body):
	print(str(response_code) + "  返回:" + JSON.stringify(body))
