extends TextureButton

@onready var task = $".."
@onready var progress_bar = $ProgressBar
@onready var timer = $Timer
@onready var main = TransferStation.main
var https = TransferStation.https

func delete() -> void:
	var homework = await https.get_homework() # [{ "contents": ["测试"], "subject": "数学" }]
	for i in homework:
		if i.subject == task.subject: # 找到自己学科所在位置
			for j in i.contents:
				if j == task.get_final_text():
					i.contents.erase(j)
	
	await https.post_homework(JSON.stringify(homework))
	main.refresh()
	
	task.get_node("..").queue_free()


func _on_timer_timeout():
	if not button_pressed:
		timer.stop()
		progress_bar.value = 0
		return
	
	if progress_bar.value == 100:
		timer.stop()
		delete()
	else:
		progress_bar.value += 1

func _on_button_down():
	timer.start()
