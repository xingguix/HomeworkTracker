extends Panel
class_name Task

@onready var buttonclicksound = $buttonclicksound
@onready var yeesound = $yeesound
@onready var texture_rect = $"完成按钮/TextureRect"
@onready var label = $Label
@onready var button = $"完成按钮"
@onready var particle = TransferStation.particle

var state: bool = false
@export var text: String = "示例text"
var subject: String

# TODO 这些函数都要去掉了
func get_subject():
	return subject

func set_subject(sub: String):
	subject = sub

func set_state(b: bool):
	label.text = text
	state = b

func get_text()->String:
	label.text = text
	return label.text

func get_state() -> bool:
	return state

func toggle():
	if state == true:
		state = false
		return
	
	state = true
	particle.emit_signal("emit")
	yeesound.pitch_scale = randf_range(0.9, 1.1)
	yeesound.start()

func _on_完成按钮_pressed():
	toggle()
	buttonclicksound.play()
	button.hide()
	button.show()
	# 用来释放焦点

func switch_scale():
	var line_count = label.get_line_count()
	var total_height = label.get_line_height() * line_count * 1.2
	if total_height <= custom_minimum_size.y:
		return
	custom_minimum_size.y = total_height


func _process(delta):
	switch_scale()
	label.text = text
	texture_rect.visible = state
