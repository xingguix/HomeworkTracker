extends VBoxContainer

@onready var label = $Label
@onready var task_template = $"任务栏模板"

@export var subject_name = "数学"

func _process(delta):
	label.text = subject_name

func add_task(task: String):
	var new_task = task_template.duplicate()
	new_task.task = task
	new_task.name = "任务"
	new_task.visible = true
	add_child(new_task)
